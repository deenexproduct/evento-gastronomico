# Endpoints del registro. Ambos son opcionales: sin ellos la landing funciona
# igual (el cupo sale del valor estático en src/data/evento.js y el registro cae
# a WhatsApp con los datos precargados).
#
# Copiar a .env.local y completar cuando el backend esté arriba.

# POST del formulario. Recibe JSON con:
#   { nombre, marca, rol, locales, whatsapp, email, ciudad, acepta, evento, origen }
# Tiene que responder JSON con { ok: true } y, si ya emite el código, { codigo }.
VITE_REGISTRO_ENDPOINT=

# GET del cupo en vivo. Tiene que responder { ocupados: number, total?: number }.
VITE_CUPO_ENDPOINT=
